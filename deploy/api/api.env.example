# Production settings for the FayFort API on the VPS. Copy to /opt/fayfort/api.env, fill in the
# secrets there (never in git), then: chmod 600 /opt/fayfort/api.env
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=8001
PUBLIC_API_URL=https://api.fayfort.com
APP_PUBLIC_URL=https://app.fayfort.com
ALLOWED_ORIGINS=https://app.fayfort.com

SUPABASE_URL=https://lirauxdhnknfiqjnulxb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HF_TOKEN=
META_VERIFY_TOKEN=

DIRECTORY_TOOLS_ENABLED=true
# Background jobs run here, on the always-on host. Turn the same flags OFF on the development PC
# (its .env) once this server is live, so two machines never run the same jobs.
AUTOMATION_SCHEDULER_ENABLED=true
INBOUND_RECONCILIATION_ENABLED=true
REQUEST_MEDIA_RETENTION_ENABLED=true
MEMBER_CHAT_RETENTION_ENABLED=true
INFRASTRUCTURE_MONITOR_ENABLED=true

# Auth and workforce plan. Turn STAFF_MFA_REQUIRED on only after every platform admin and worker has
# set up two-step verification in the Control Center; from then on staff API calls need an aal2 session.
STAFF_MFA_REQUIRED=false
# Must equal Supabase Auth -> Email -> "Email OTP expiration" (seconds). Set both to 86400 so
# invitation and reset links last 24 hours (Supabase defaults to 3600).
AUTH_EMAIL_LINK_TTL_SECONDS=86400

# Email system plan (ED1). FayFort's own emails (customer updates, newsletter, staff resets) go
# through the Resend API. Paste the API key here only (never in git or chat), then set
# EMAIL_DELIVERY_ENABLED=true and restart the API. Nothing is sent while either is missing.
RESEND_API_KEY=
EMAIL_FROM=FayFort <updates@fayfort.com>
EMAIL_REPLY_TO=support@fayfort.com
EMAIL_DELIVERY_ENABLED=false

# Products and commerce plan (P0). Shopify is the commerce engine. Create a Dev Dashboard app on the
# store, install it, and paste its client id and secret here (never in git or chat). The secret also
# verifies Shopify webhooks. The Storefront token comes from the Headless sales channel (private token)
# and powers checkout; without it checkout falls back to Shopify cart links.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
# Full catalog reconcile every 6 hours (webhooks keep it current in between) and intent-event pruning.
COMMERCE_SYNC_ENABLED=true
COMMERCE_CURRENCY=USD
COMMERCE_UNDER_PRICE=25
# Optional: Meta "app_id|client_token" for Instagram link previews in Find It.
META_OEMBED_ACCESS_TOKEN=

# Human handoff windows: a customer is never left in silence after asking for a person.
HANDOFF_WINDOW_ENABLED=true
HANDOFF_WAIT_MINUTES=15
HANDOFF_IDLE_MINUTES=30
HANDOFF_HOLDING_INTERVAL_MINUTES=5
# Database keep-alive so the Supabase Free project is never paused for inactivity.
DATABASE_KEEPALIVE_ENABLED=true
DATABASE_KEEPALIVE_INTERVAL_SECONDS=21600
