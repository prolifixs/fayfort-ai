# FayFort AI API settings. Copy to .env and fill in. This file is the single source of truth:
# python -m app, the PowerShell launchers, the CLI and the dashboard dev server all read it.

# Where the local API listens.
API_HOST=127.0.0.1
API_PORT=8001

# Public addresses (docs/PLATFORM_CONSOLIDATION_PLAN.md, Gates 2 and 4).
# PUBLIC_API_URL: the HTTPS address providers such as Meta reach, e.g. https://api-dev.fayfort.com
PUBLIC_API_URL=
# APP_PUBLIC_URL: where the dashboard is served (local dev default shown).
APP_PUBLIC_URL=http://127.0.0.1:5173
# ALLOWED_ORIGINS: extra comma-separated browser origins for CORS, e.g. https://app.fayfort.com
ALLOWED_ORIGINS=
# WORKER_INVITE_REDIRECT_URL: leave empty to use APP_PUBLIC_URL + /worker/accept.
WORKER_INVITE_REDIRECT_URL=

# Supabase (secrets: never commit real values).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider.
HF_TOKEN=
# HF_MODEL=openai/gpt-oss-20b:deepinfra

# Meta webhook verification token (any long random string; the same value goes into Meta's webhook settings).
META_VERIFY_TOKEN=

# Background jobs.
AUTOMATION_SCHEDULER_ENABLED=false
INBOUND_RECONCILIATION_ENABLED=true
REQUEST_MEDIA_RETENTION_ENABLED=true
MEMBER_CHAT_RETENTION_ENABLED=true
# Cloudflare/tunnel/webhook health checks with admin alerts (Gate 3).
INFRASTRUCTURE_MONITOR_ENABLED=false
INFRASTRUCTURE_MONITOR_INTERVAL_SECONDS=300
